# Copy these names into Netlify: Site configuration > Environment variables.
# Never put real values in this file and never commit a real .env file.

# A password you choose. The app sends it with every request so strangers cannot use your keys.
ACCESS_CODE=

# AI voiceover, free option (optional): Cloudflare Workers AI has a free daily allowance.
# Account ID: Cloudflare dashboard > Workers & Pages (shown on the right). Token: My Profile > API Tokens > Workers AI template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# AI voiceover, paid option (optional). Your own OpenAI key goes here. Used only if Cloudflare is not set,
# or if you set TTS_PROVIDER=openai.
# Do not use the name OPENAI_API_KEY: Netlify fills that one in by itself with a key that does not work here.
OPENAI_TTS_API_KEY=

# Used for stock video and photos (optional)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: openai or cloudflare. Only needed if both voice services are set and you want to choose.
TTS_PROVIDER=
