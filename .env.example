# Copy these names into Netlify: Site configuration > Environment variables.
# Never put real values in this file and never commit a real .env file.

# A password you choose. The app sends it with every request so strangers cannot use your keys.
ACCESS_CODE=

# Used for AI voiceover (optional). Your own OpenAI key goes here.
# Do not use the name OPENAI_API_KEY: Netlify fills that one in by itself with a key that does not work here.
OPENAI_TTS_API_KEY=

# Used for stock video and photos (optional)
PEXELS_API_KEY=
PIXABAY_API_KEY=
