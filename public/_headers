# Security headers. Vite copies this file into dist/, and both Netlify and Cloudflare read it from there.
# These apply to the web page and its files. The /api/* answers get their own headers in server/shared.ts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=()
  # Report-Only: the browser lists anything this policy WOULD block in the console, but blocks nothing yet.
  # After a full run (Generate, voiceover, camera, Export) shows no CSP messages in the browser console,
  # rename this header to Content-Security-Policy to enforce it.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; media-src 'self' blob: https:; connect-src 'self' blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
