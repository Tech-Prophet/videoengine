
{
  // Cloudflare Workers settings.
  "name": "videoengine",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "keep_vars": true,
  "previews": {}
}
